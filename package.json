{
  "name": "playwright-sauce-demo",
  "version": "1.0.0",
  "description": "Playwright test suite for Sauce Demo app.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:run": "npx playwright test",
    "test:open": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueslialmeida/playwright-sauce-demo.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ueslialmeida/playwright-sauce-demo/issues"
  },
  "homepage": "https://github.com/ueslialmeida/playwright-sauce-demo#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^8.0.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
